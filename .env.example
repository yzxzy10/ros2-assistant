# 复制本文件为 .env 后填写真实值（.env 已被 .gitignore 排除）
#
#   cp .env.example .env

# ----- 大模型密钥（必填）-----
# 阿里云百炼 / DashScope 控制台获取
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ----- 访问令牌 -----
# 公开分享（谁都能用、各看各的）：留空。身份由服务端签发的匿名 Cookie 保证，
# 请求里自报的 uid 会被忽略，所以冒充不了别人。
#
# 内部小范围（要一道门）：填一个令牌，访问者输一次即可
# ROS2_AUTH_TOKEN=一串足够长的随机字符
#
# 固定几个人、互不可见（令牌绑定 uid）：
# ROS2_AUTH_TOKEN=tokenA:u_alice,tokenB:u_bob

# ----- 限流 -----
# 公开分享务必保留：脚本循环请求会同时拖垮服务和模型额度。
# 0 表示关闭该类限流。
ROS2_RATE_CHAT_PER_MIN=20
ROS2_RATE_API_PER_MIN=120
# 全站每日对话总次数（保险丝），0 = 不限。公开分享时强烈建议保留一个数。
ROS2_DAILY_CHAT_MAX=2000

# ----- IP 白名单（可选）-----
# 支持单个 IP 与 CIDR（网段），配了就只允许这些地址访问；
# 与令牌同时配置时是"并且"关系：先过 IP，再过令牌。
# ROS2_ALLOW_IPS=127.0.0.1,::1,192.168.0.0/16
#
# 跑在 Nginx 等反代后面、需要读真实客户端 IP 时打开。
# 默认不信任 X-Forwarded-For（否则任何人改个头就能伪装 IP）。
# ROS2_TRUST_PROXY=1

# ----- 身份签名密钥 -----
# 不填则自动生成并写入 data/.id_secret（跟随数据卷，重启不失效）。
# 多实例共用同一份数据时必须显式指定同一个值。
# ROS2_ID_SECRET=

# ----- 数据目录 -----
# 指向挂载卷，容器重建不丢数据；不填则用项目根目录
# ROS2_DATA_DIR=/data

# ----- 其他 -----
# PORT=8000
# HTTPS 部署时让 Cookie 带上 Secure 标记（反代传 X-Forwarded-Proto: https 也会自动识别）
# ROS2_COOKIE_SECURE=1
